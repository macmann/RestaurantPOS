# RestaurantPOS local network deployment template

# Environment
APP_ENV=development
APP_NAME=RestaurantPOS
# POS always uses the local DB_* database. CLOUD uses its own DATABASE_URL.
APP_MODE=POS

# Branch/location reporting partition
POS_BRANCH_ID=main-floor
POS_BRANCH_NAME="Main Floor"
POS_LOCATION_LABEL="Main dining room"
POS_BRANCH_TIMEZONE=America/New_York
# New business day starts at this branch-local wall-clock time (HH:mm).
POS_BUSINESS_DAY_CUTOFF=04:00

# Network
HOST=0.0.0.0
PORT=8080
LAN_BASE_URL=http://192.168.1.100:8080

# Database
# Set DATABASE_URL for managed PostgreSQL providers such as Neon. Leave blank for local DB_* configuration.
# DATABASE_URL=postgres://pos_user:change_me@ep-example.us-east-2.aws.neon.tech/restaurant_pos?sslmode=require
# Use postgres for either DATABASE_URL or DB_* settings. Set this to memory only to explicitly disable PostgreSQL.
POS_REPOSITORY_BACKEND=postgres
DB_CLIENT=postgres
DB_HOST=192.168.1.50
DB_PORT=5432
DB_NAME=restaurant_pos
DB_USER=pos_user
DB_PASSWORD=change_me
DB_SSL=false

# Optional outbound-only hybrid synchronization (POS deployment)
# CLOUD_API_URL=https://pos-cloud.example.com
# SYNC_API_TOKEN=replace-with-a-long-random-shared-secret
POS_STORE_ID=main-floor
POS_DEVICE_ID=register-server-1
SYNC_PUSH_INTERVAL_MS=30000
SYNC_POLL_INTERVAL_MS=10000
SYNC_REQUEST_TIMEOUT_MS=8000
SYNC_BATCH_SIZE=100
# Successful outbox rows may be archived/purged by operations after this age.
SYNC_SUCCESS_RETENTION_DAYS=30

# LAN reconnect/retry policy
POS_RECONNECT_INITIAL_DELAY_MS=500
POS_RECONNECT_MAX_DELAY_MS=10000
POS_RECONNECT_JITTER_MS=250
POS_RETRY_MAX_SAFE_ATTEMPTS=6
POS_RETRY_MAX_UNSAFE_ATTEMPTS=1
POS_HEALTH_CHECK_INTERVAL_MS=5000

# Locale and timezone
DEFAULT_LOCALE=en-US
DEFAULT_CURRENCY=USD
TIMEZONE=America/New_York

# Logging and auditing
LOG_LEVEL=info
AUDIT_RETENTION_DAYS=365
